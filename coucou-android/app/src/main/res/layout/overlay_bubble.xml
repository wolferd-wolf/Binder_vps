<?xml version="1.0" encoding="utf-8"?>
<!-- COUCOU Sprint 2: collapsed floating bubble (inflated by OverlayService as
     "overlay_bubble"; IDs resolved reflectively: bubble_root + bubble_mic + ask_result
     + coucou_character). Owns res/layout in coucou-android.
     Coucou theme tokens only, zero raw hex.
     Sprint 2 change: static launcher ImageView replaced by the procedural
     com.coucou.android.CoucouCharacterView canvas (@OpenCode owner, lands
     separately). Until that class lands, inflateLayoutByName catches the
     inflation error and falls back to the programmatic bubble.
     Sprint 4 adjustment: character match_parent + margin inside token card per @Buffy final tokens.
     SPRINT 4.7/4.10 snug contract: card = @dimen/coucou_bubble_size (48dp, MUST equal
     coucou_bubble_card_size — OverlayService clamps/drags against that one), radius =
     @dimen/coucou_bubble_corner_radius (18dp), fill = @color/coucou_bubble_bg (#141518)
     with the @color/coucou_hairline 1dp stroke — dark squircle, never white.
     WRAP_CONTENT guard: ensureContainer()/applyCollapsedParams() keep window WRAP_CONTENT,
     so the card stays at the 48dp token and the character fills it with a 3dp margin,
     preventing the collapsed window from measuring to screen size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubble_root"
    android:layout_width="@dimen/coucou_bubble_size"
    android:layout_height="@dimen/coucou_bubble_size">

<com.google.android.material.card.MaterialCardView
        android:id="@+id/bubble_card"
        android:layout_width="@dimen/coucou_bubble_size"
        android:layout_height="@dimen/coucou_bubble_size"
        android:padding="3dp"
        app:cardCornerRadius="@dimen/coucou_bubble_corner_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/coucou_bubble_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/coucou_hairline">

        <com.coucou.android.CoucouCharacterView
            android:id="@+id/coucou_character"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="3dp"
            android:contentDescription="@string/app_name" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
