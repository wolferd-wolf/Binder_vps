<?xml version="1.0" encoding="utf-8"?>
<!-- COUCOU Sprint 2: collapsed floating bubble (inflated by OverlayService as
     "overlay_bubble"; IDs resolved reflectively: bubble_root + bubble_mic + ask_result
     + coucou_character). Owns res/layout in coucou-android.
     Coucou theme tokens only, zero raw hex.
     Sprint 2 change: static launcher ImageView replaced by the procedural
     com.coucou.android.CoucouCharacterView canvas (@OpenCode owner, lands
     separately). Until that class lands, inflateLayoutByName catches the
     inflation error and falls back to the programmatic bubble.
     Sprint 4 adjustment: character match_parent+4dp inside token card per @Buffy final tokens.
     Ratio: 53dp/66dp=80.3% target; our 58dp/66dp=88% keeps one number for all consumers.
     WRAP_CONTENT guard: ensureContainer()/applyCollapsedParams() keep window WRAP_CONTENT,
     so card stays @dimen/coucou_bubble_card_size (66dp) and character uses match_parent+4dp
     inside it to prevent collapsed window from measuring to screen size. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubble_root"
    android:layout_width="@dimen/coucou_bubble_size"
    android:layout_height="@dimen/coucou_bubble_size">

<com.google.android.material.card.MaterialCardView
        android:id="@+id/bubble_card"
        android:layout_width="@dimen/coucou_bubble_size"
        android:layout_height="@dimen/coucou_bubble_size"
        android:padding="3dp"
        app:cardCornerRadius="@dimen/coucou_bubble_corner_radius"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/coucou_bubble_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/coucou_hairline">

        <com.coucou.android.CoucouCharacterView
            android:id="@+id/coucou_character"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="3dp"
            android:contentDescription="@string/app_name" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
