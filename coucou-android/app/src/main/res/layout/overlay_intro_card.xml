<?xml version="1.0" encoding="utf-8"?>
<!-- COUCOU Desktop Intro Card: centered dark card with character on service start.
     Matches upstream Coucou desktop island styling from windows/src/style.css.
     Buffy tokens: #141518 background, 20dp radius. 280dp x 120dp as per Sprint 4 spec. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intro_card_root"
    android:layout_width="280dp"
    android:layout_height="120dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/intro_card"
        android:layout_width="280dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        app:cardCornerRadius="@dimen/coucou_prompt_card_radius"
        app:cardBackgroundColor="@color/coucou_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/coucou_hairline">

        <com.coucou.android.CoucouCharacterView
            android:id="@+id/coucou_character"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name" />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>