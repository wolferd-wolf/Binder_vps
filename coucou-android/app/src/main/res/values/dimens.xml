<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Character engine geometry tokens (ported from engine.ts) -->
    <dimen name="coucou_character_eye_separation">0.37sp</dimen>
    <dimen name="coucou_character_eye_offset">0dp</dimen>

    <!-- Character size scale -->
    <dimen name="coucou_character_size">48dp</dimen>
    <dimen name="coucou_character_size_small">36dp</dimen>
    <dimen name="coucou_character_size_large">64dp</dimen>

    <!-- Eye geometry (procedural paths) -->
    <dimen name="coucou_eye_width">5dp</dimen>
    <dimen name="coucou_eye_height">7dp</dimen>
    <dimen name="coucou_eye_offscreen">0dp</dimen>

    <!-- Character softness / rounding -->
    <dimen name="coucou_character_corner_radius">12dp</dimen>
    <dimen name="coucou_character_padding">4dp</dimen>

<!-- COUCOU desktop prompt box: shape & spacing.
     Source: docs/coucou_desktop_prompt_box_and_animation_report.md §1.2
     (upstream .card / .chat-bar / .chat-input in style.css).
     Consumers: @Cline's overlay_bubble / overlay_ask_bar. -->
    <dimen name="coucou_prompt_card_radius">20dp</dimen>
    <dimen name="coucou_prompt_card_stroke">1dp</dimen>
    <dimen name="coucou_input_bar_radius">12dp</dimen>
    <dimen name="coucou_input_bar_padding_h">10dp</dimen>
    <dimen name="coucou_input_bar_padding_v">6dp</dimen>
    <dimen name="coucou_input_gap">8dp</dimen>
    <dimen name="coucou_input_text_size">13sp</dimen>

    <!-- Prompt box: character placement (report §1.2, Sprint 4 size bump).
     Collapsed bubble: 48dp character centred in a 66dp card.
     Sprint 4: a true ~20% bump — 56dp → 66dp card, 44dp → 48dp character — so
     Mochi reads better on high-DPI screens. @Boss chose the +20% bump over the
     directive's literal 52-54dp reading (the directive's "~44dp" named the
     canvas; the card was already 56dp, so 53dp would have shrunk it). An
     interim 54dp/42dp literal pass in this file was superseded accordingly.
     The card token doubles as @OverlayService.bubbleCardPx(): the collapsed
     window rectangle measured before the first layout pass, so the window
     grows with the token.
     Expanded ask bar: 40dp avatar leading the row, 8dp gap to the input. -->
    <dimen name="coucou_bubble_card_size">66dp</dimen>
    <dimen name="coucou_bubble_character_size">48dp</dimen>
    <dimen name="coucou_ask_character_size">40dp</dimen>
    <dimen name="coucou_ask_character_margin_end">8dp</dimen>

    <!-- Animation timings — corrected to the upstream engine.ts values
         (report §2); the engine hardcodes the same numbers, these tokens are
         the QA/documentation contract. Millisecond values are unitless to match
         the existing convention in this file. -->
    <dimen name="coucou_animation_blink_duration">200</dimen>
    <dimen name="coucou_animation_blink_close_duration">70</dimen>
    <dimen name="coucou_animation_blink_open_duration">130</dimen>
    <dimen name="coucou_animation_blink_interval_min">2200</dimen>
    <dimen name="coucou_animation_blink_interval_max">5400</dimen>
    <dimen name="coucou_animation_bob_amplitude">4dp</dimen>
    <dimen name="coucou_animation_bob_cycle">3490</dimen>
    <!-- Look-around retarget interval: engine.ts mini-look is
         n + 0.5 + rand*1.5 => 0.5s to 2.0s. NOTE: report §2.3's prose says
         "2.0-5.0s" but its own formula and engine.ts:528 both give 0.5-2.0s;
         token follows the code (OpenCode implemented 0.5-2.0s). -->
    <dimen name="coucou_animation_look_interval_min">500</dimen>
    <dimen name="coucou_animation_look_interval_max">2000</dimen>
    <dimen name="coucou_animation_eye_tilt_amount">0.06</dimen>
    <dimen name="coucou_animation_badge_scale">1.15</dimen>
</resources>
