    <dimen name="coucou_input_gap">8dp</dimen>
    <dimen name="coucou_input_text_size">13sp</dimen>

    <!-- Prompt box: character placement — SPRINT 4 board task 1 "Bubble Size Ratio".
     Collapsed bubble: 53dp character canvas centred in the 66dp card = 80.3%
     canvas/card, the board's "~80% fill" target. It was 48dp (72.7%), which is
     the "massive empty squircle" the board describes; 66dp card kept as-is
     because @Boss approved it (+20%) and it is the size the sprint shipped.
     Board math: its example (54dp card / 46dp canvas) is exactly a 4dp margin
     inside the card — 54 - 8 = 46 — i.e. the same ~85% ratio, scaled to our
     66dp card. If @Cline's match_parent + 4dp-margin variant lands, the canvas
     becomes card - 8dp = 58dp (88%) and this token simply stops being read;
     with an explicit canvas it yields the 80% here.
     Caveat for @AGY's "Mochi fills ~80%" check: the ink is only ~68% of the
     canvas (RADIUS_RATIO 0.3f in CoucouCharacterView), so Mochi reads ~55% of
     the card until @OpenCode's task 1 (body filling its bounds) lands — no
     token can close that gap, the canvas cannot exceed the card.
     The card token doubles as @OverlayService.bubbleCardPx(): the collapsed
     window rectangle before the first layout pass, and the basis of the drag
     clamp + edge snap — it must stay equal to the card the layout draws.
     Expanded ask bar: 40dp avatar leading the row, 8dp gap to the input.
     SPRINT 4.7 SUPERSEDES THE 66dp/53dp NUMBERS ABOVE (kept as provenance, not as
     spec): the device run called the card "slightly too big and square", so the
     card is now 48dp per the board ("snug to 48dp, or 46dp") and the legacy square
     character token drops to 38dp so it can never exceed the card it sits in. -->
    <dimen name="coucou_bubble_card_size">48dp</dimen>
    <dimen name="coucou_bubble_character_size">38dp</dimen>

    <!-- SPRINT 4.7 snug-bubble contract — @Buffy owns these, @Cline's
         overlay_bubble.xml consumes them (board names them explicitly):
           coucou_bubble_size            48dp  board's name for the SAME number as
                                               coucou_bubble_card_size
           coucou_bubble_corner_radius   18dp  smooth squircle on the 48dp card (37.5%)
           coucou_character_collapsed_width / _height  38dp x 30dp  Mochi box in the card
         SPRINT 4.10: the Origin Island dock pill is 100% CANCELLED — its tokens
         (coucou_origin_island_radius / _pill_width / _pill_height) and their
         consumers were purged; do not re-add them.
         coucou_bubble_size MUST stay equal to coucou_bubble_card_size: the latter is
         OverlayService.bubbleCardPx() — the collapsed window rectangle and the basis of
         the drag clamp + edge snap — so a split between the two draws one card and
         clamps another. -->
    <dimen name="coucou_bubble_size">48dp</dimen>
    <dimen name="coucou_bubble_corner_radius">18dp</dimen>
    <dimen name="coucou_character_collapsed_width">38dp</dimen>
    <dimen name="coucou_character_collapsed_height">30dp</dimen>
    <dimen name="coucou_ask_character_size">40dp</dimen>
    <dimen name="coucou_ask_character_margin_end">8dp</dimen>

    <!-- Animation timings — corrected to the upstream engine.ts values
         (report §2); the engine hardcodes the same numbers, these tokens are
         the QA/documentation contract. Millisecond values are unitless to match
         the existing convention in this file. -->
    <dimen name="coucou_animation_blink_duration">200</dimen>
    <dimen name="coucou_animation_blink_close_duration">70</dimen>
    <dimen name="coucou_animation_blink_open_duration">130</dimen>
    <dimen name="coucou_animation_blink_interval_min">2200</dimen>
    <dimen name="coucou_animation_blink_interval_max">5400</dimen>
    <dimen name="coucou_animation_bob_amplitude">4dp</dimen>
    <dimen name="coucou_animation_bob_cycle">3490</dimen>
    <!-- Look-around retarget interval: engine.ts mini-look is
         n + 0.5 + rand*1.5 => 0.5s to 2.0s. NOTE: report §2.3's prose says
         "2.0-5.0s" but its own formula and engine.ts:528 both give 0.5-2.0s;
         token follows the code (OpenCode implemented 0.5-2.0s). -->
    <dimen name="coucou_animation_look_interval_min">500</dimen>
    <dimen name="coucou_animation_look_interval_max">2000</dimen>
    <dimen name="coucou_animation_eye_tilt_amount">0.06</dimen>
    <dimen name="coucou_animation_badge_scale">1.15</dimen>

    <!-- SPRINT 4.6 EMERGENCY RECOVERY — top island geometry.
         SPRINT 4.5's 92dp intro clipped Mochi's lower body and the starry card, so the
         intro grows to 175dp: header bar + full Mochi, nothing cut in half.
           intro    360 x 175dp  (Phase 1 — greeting)
           expanded 360 x 270dp  (Phase 3 — assistant panel tapped open)
         coucou_island_width is the width both phases share, named by the SPRINT 4.6 board.
         coucou_island_intro_width is the token OverlayService reads today
         (startGreetingOverlay / onIslandSized), so it carries the same 360dp literal
         instead of a @dimen reference — both stay greppable and must stay equal. -->
    <dimen name="coucou_island_width">360dp</dimen>
    <dimen name="coucou_island_intro_width">360dp</dimen>
    <dimen name="coucou_island_intro_height">175dp</dimen>
    <dimen name="coucou_island_expanded_height">270dp</dimen>

    <!-- SPRINT 4.10: Origin Island dock pill geometry (120 x 36dp) REMOVED with
         overlay_origin_island.xml — the pill idea is cancelled per @Boss. -->
</resources>
