<?xml version="1.0" encoding="utf-8"?>
<!-- SPRINT 4.12: background for the expanded WebUI assistant drawer
     (@OpenCode's "webViewContainer" in OverlayService.kt).
     WHY IT EXISTS: the drawer's WebView renders transparent, so the window has
     no rounded outline of its own — and ViewOutlineProvider.BACKGROUND (board
     task, Pane 1) derives its clip outline from THIS background. Without a
     rounded background the outline is a plain rect, clipToOutline does nothing,
     and the bottom corners stay sharp after sending messages (device defect #2).
     Spec (board, verbatim): radius 20dp, fill #141518 — token references only,
     zero raw hex:
       radius  20dp   -> @dimen/coucou_prompt_card_radius (the desktop ".card"
                         20px radius; same value the WebUI CSS must hold)
       fill    #141518 -> @color/coucou_bubble_bg (dark card, NEVER white; the
                         page paints the identical colour, so the native fill
                         is seamless behind the transparent WebView)
     No stroke: the WebUI card draws its own hairline in CSS; a native one here
     would double the edge. CONSUMERS: @OpenCode sets this as the expanded
     container's background BEFORE outlineProvider/clipToOutline. The collapsed
     bubble keeps its own tokens (coucou_bubble_corner_radius 18dp) — this
     drawable is STATE B only. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/coucou_bubble_bg" />
    <corners android:radius="@dimen/coucou_prompt_card_radius" />
</shape>
